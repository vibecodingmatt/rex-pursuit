{
    "name":  "rex-pursuit",
    "version":  "0.1.0",
    "private":  true,
    "type":  "module",
    "scripts":  {
                    "dev":  "vite --host 127.0.0.1 --port 5188",
                    "build":  "vite build",
                    "preview":  "vite preview --host 127.0.0.1 --port 5188",
                    "start":  "node scripts/serve.mjs",
                    "test":  "node scripts/test-combat.mjs && node scripts/verify-chase.cjs",
                    "test:smoke": "node scripts/smoke.cjs",
                    "test:touch": "node scripts/test-touch.mjs && node scripts/verify-touch.cjs",
                    "test:gaze": "node scripts/verify-gaze.cjs",
                    "test:logic": "node scripts/test-combat.mjs && node scripts/test-defeat.mjs && node scripts/test-ambush.mjs && node scripts/test-touch.mjs && node scripts/test-victory.mjs && node scripts/test-safari.mjs",
                    "test:safari": "node scripts/test-safari.mjs && node scripts/verify-safari.cjs",
                    "test:safari-motion": "node scripts/verify-safari-motion.cjs",
                    "test:release": "node scripts/test-release.mjs",
                    "test:pages": "node scripts/verify-pages.cjs",
                    "social:render": "node scripts/create-social.cjs",
                    "test:creature-lab": "node scripts/verify-creature-lab.cjs",
                    "test:lab":  "node scripts/verify.cjs",
                    "test:build":  "node scripts/verify-build.cjs",
                    "test:gait":  "node scripts/verify-gait.cjs",
                    "test:motion":  "node scripts/verify-motion.cjs",
                    "test:vehicle":  "node scripts/verify-vehicle.cjs",
                    "test:gunner": "node scripts/verify-gunner.cjs",
                    "test:arcade":  "node scripts/verify-arcade.cjs",
                    "test:pressure":  "node scripts/verify-pressure.cjs",
                    "test:debris": "node scripts/verify-debris.cjs",
                    "test:cinematic": "node scripts/test-ambush.mjs && node scripts/verify-cinematic.cjs",
                    "test:treeline": "node scripts/verify-treeline.cjs",
                    "test:ford": "node scripts/verify-ford.cjs",
                    "test:wildlife": "node scripts/verify-wildlife.cjs",
                    "test:defeat": "node scripts/test-defeat.mjs && node scripts/verify-defeat-gait.cjs && node scripts/verify-defeat.cjs",
                    "test:vision": "node scripts/test-defeat.mjs && node scripts/verify-defeat-vision.cjs",
                    "test:victory": "node scripts/test-victory.mjs && node scripts/verify-victory.cjs",
                    "art:brachio": "node scripts/build-brachio.mjs",
                    "art:safari": "node scripts/build-safari.mjs",
                    "test:balance":  "node scripts/simulate-pressure.mjs",
                    "audio:split":  "node scripts/split-audio.cjs",
                    "art:export":  "node scripts/export-model.cjs"
                },
    "dependencies":  {
                         "three":  "0.180.0"
                     },
    "devDependencies":  {
                            "playwright-core":  "^1.61.1",
                            "vite":  "^5.4.20"
                        }
}
